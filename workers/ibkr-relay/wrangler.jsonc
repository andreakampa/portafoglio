// Pubblicazione: npx wrangler@4 deploy -c workers/ibkr-relay/wrangler.jsonc
{
  "name": "ibkr-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Limite di richieste per indirizzo IP (finestra di 60 secondi). namespace_id: numero libero, unico nell'account.
  "ratelimits": [
    { "name": "RELAY_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
