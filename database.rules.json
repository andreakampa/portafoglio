{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "invites": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "$code.matches(/^[A-Z0-9-]{8,32}$/)",
        "usedBy": {
          ".write": "auth != null && !data.exists() && root.child('invites').child($code).exists() && newData.val() === auth.uid && newData.parent().parent().parent().child('members').child(auth.uid).child('invite').val() === $code"
        }
      }
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('invite').isString() && newData.child('invite').val().matches(/^[A-Z0-9-]{8,32}$/) && root.child('invites').child(newData.child('invite').val()).exists() && !root.child('invites').child(newData.child('invite').val()).child('usedBy').exists() && newData.parent().parent().child('invites').child(newData.child('invite').val()).child('usedBy').val() === auth.uid && newData.child('email').val() === auth.token.email) || (auth.uid === $uid && data.exists() && !newData.exists() && root.child('admins').child(auth.uid).val() !== true))"
      }
    },
    "notice": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.child('closesAt').isNumber() && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 300))"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('members').child($uid).exists()",
        ".write": "auth != null && ((auth.uid === $uid && root.child('members').child($uid).exists() && (!root.child('members').child($uid).child('suspendedAt').exists() || !newData.exists())) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true && root.child('members').child($uid).child('deleteAfter').isNumber() && root.child('members').child($uid).child('deleteAfter').val() <= now))"
      }
    }
  }
}
